FENGMOU_ENVIRONMENT=development
FENGMOU_DATABASE_URL=sqlite:///./data/fengmou.db
# development/demo default to "upgrade"; deployed environments should use "verify"
# after running `python -m app.schema upgrade` as a separate release step.
FENGMOU_DATABASE_SCHEMA_MODE=upgrade
FENGMOU_STORAGE_ROOT=./data/storage
FENGMOU_MAX_UPLOAD_BYTES=524288000
FENGMOU_ALLOW_DEMO_ANALYZER=false
# inline keeps the single-command demo; external requires `python -m app.worker`.
FENGMOU_VERIFICATION_EXECUTION_MODE=inline
FENGMOU_VERIFICATION_LEASE_SECONDS=30
FENGMOU_VERIFICATION_HEARTBEAT_SECONDS=10
FENGMOU_VERIFICATION_MAX_ATTEMPTS=3
FENGMOU_VERIFICATION_WORKER_POLL_SECONDS=1
# Local diagnostic thresholds; these are not SLA objectives.
FENGMOU_VERIFICATION_QUEUE_WARNING_SECONDS=60
FENGMOU_VERIFICATION_OBSERVABILITY_WINDOW_SECONDS=900
FENGMOU_OPERATOR_API_KEY=replace-with-a-long-random-operator-key
FENGMOU_REVIEWER_API_KEY=replace-with-a-different-long-random-reviewer-key
FENGMOU_AUDITOR_API_KEY=replace-with-a-third-long-random-auditor-key
# Independent HMAC secret for standard GPKG preview tokens (do NOT reuse operator key).
# Required outside development/test/demo. Never commit a real value.
FENGMOU_GPKG_PREVIEW_SIGNING_SECRET=replace-with-a-long-random-gpkg-preview-signing-secret
# Optional: default 32 MiB and 15 minutes.
# FENGMOU_STANDARD_GPKG_MAX_UPLOAD_BYTES=33554432
# FENGMOU_GPKG_PREVIEW_TOKEN_TTL_SECONDS=900
# Disabled by default. When enabled, every field below is required.
FENGMOU_REMOTE_ANALYZER_ENABLED=false
FENGMOU_REMOTE_ANALYZER_URL=https://algorithm.example.internal/v1/analyze
FENGMOU_REMOTE_ANALYZER_API_KEY=replace-with-a-dedicated-remote-service-secret
FENGMOU_REMOTE_ANALYZER_MODEL_NAME=hidden-work-baseline
FENGMOU_REMOTE_ANALYZER_MODEL_VERSION=0.1.0
FENGMOU_REMOTE_ANALYZER_MODEL_SHA256=replace-with-64-lowercase-hex-characters
# "model" is the safe default. "stub" is accepted only with FENGMOU_ENVIRONMENT=test/demo.
FENGMOU_REMOTE_ANALYZER_EXPECTED_RUNTIME_MODE=model
FENGMOU_REMOTE_ANALYZER_TIMEOUT_SECONDS=120
FENGMOU_REMOTE_ANALYZER_MAX_UPLOAD_BYTES=104857600
FENGMOU_REMOTE_ANALYZER_MAX_RESPONSE_BYTES=2097152
# Optional standalone contract reference service (app.reference_analyzer:app).
# It is a STUB with empty observations, not a model or accuracy implementation.
FENGMOU_REFERENCE_ANALYZER_BEARER_TOKEN=replace-with-a-dedicated-reference-service-secret
FENGMOU_REFERENCE_ANALYZER_MODEL_NAME=fengmou-reference-stub
FENGMOU_REFERENCE_ANALYZER_MODEL_VERSION=stub-v0.1
FENGMOU_REFERENCE_ANALYZER_MODEL_SHA256=15695d7820543d1217651812af54e91e71a30d355f8a2b851734a4f2483e454e
FENGMOU_REFERENCE_ANALYZER_MAX_UPLOAD_BYTES=104857600
FENGMOU_REFERENCE_ANALYZER_MAX_REQUEST_BYTES=65536
FENGMOU_REFERENCE_ANALYZER_MAX_RESPONSE_BYTES=2097152
FENGMOU_REFERENCE_ANALYZER_IDEMPOTENCY_CAPACITY=256
FENGMOU_CORS_ORIGINS=http://localhost:5173,http://localhost:4173
